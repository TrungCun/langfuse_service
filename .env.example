# Run: python scripts/init_env.py (generates random secrets in .env).
LANGFUSE_VERSION=4.50.0
WEB_PORT=3000
WORKER_PORT=3030
MINIO_PORT=9095
MINIO_CONSOLE_PORT=9096
# Detected Ethernet LAN address. Update URLs if the host IP/ports change.
NEXTAUTH_URL=http://10.0.10.150:3000
MEDIA_PUBLIC_URL=http://10.0.10.150:9095
POSTGRES_PASSWORD=__GENERATE__
CLICKHOUSE_PASSWORD=__GENERATE__
REDIS_AUTH=__GENERATE__
MINIO_ROOT_USER=langfuse
MINIO_ROOT_PASSWORD=__GENERATE__
NEXTAUTH_SECRET=__GENERATE__
SALT=__GENERATE__
ENCRYPTION_KEY=__GENERATE__
# Infrastructure versions follow the upstream Compose compatibility baseline.
POSTGRES_IMAGE=postgres:17
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12
REDIS_IMAGE=redis:7
# Upstream-recommended MinIO distribution. See README for digest locking.
MINIO_IMAGE=cgr.dev/chainguard/minio:latest
